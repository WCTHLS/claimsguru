# ========================================================
# Stage 1: Core Base Builder (claimgpt-core builder)
# ========================================================
FROM python:3.11-slim AS core-builder
WORKDIR /app

# Install compilation tools needed for core Python packages
RUN echo 'Acquire::ForceIPv4 "true";' > /etc/apt/apt.conf.d/99force-ipv4 \
    && apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    cmake \
    curl \
    unixodbc-dev \
    g++ \
    && rm -rf /var/lib/apt/lists/*

# Increase pip timeout and retries
ENV PIP_DEFAULT_TIMEOUT=300
ENV PIP_RETRIES=10

COPY requirements-gateway.txt /app/requirements.txt
RUN pip install --no-cache-dir -r /app/requirements.txt

# ========================================================
# Stage 2: Core Base Runner (claimgpt-core image)
# ========================================================
FROM python:3.11-slim AS core-runner
WORKDIR /app

# Copy installed Python packages from builder
COPY --from=core-builder /usr/local /usr/local
ENV PYTHONPATH=/app:/app/libs:/app/services

# Install basic runtime tools + system dependencies for WeasyPrint/GLib + MS SQL Server ODBC
RUN echo 'Acquire::ForceIPv4 "true";' > /etc/apt/apt.conf.d/99force-ipv4 \
    && apt-get update && apt-get install -y --no-install-recommends \
    curl \
    gnupg2 \
    apt-transport-https \
    ca-certificates \
    libpango-1.0-0 \
    libpangocairo-1.0-0 \
    libglib2.0-0 \
    libharfbuzz0b \
    libpangoft2-1.0-0 \
    && mkdir -p /usr/share/keyrings \
    && curl -sSL https://packages.microsoft.com/keys/microsoft.asc | gpg --dearmor -o /usr/share/keyrings/microsoft-prod.gpg \
    && curl -sSL https://packages.microsoft.com/config/debian/12/prod.list > /etc/apt/sources.list.d/mssql-release.list \
    && apt-get update \
    && ACCEPT_EULA=Y apt-get install -y --no-install-recommends msodbcsql18 unixodbc \
    && rm -rf /var/lib/apt/lists/*

# Copy libs and services code
COPY libs/ /app/libs/
COPY services/ /app/services/
COPY main.py /app/main.py

# Create storage directories and set permissive write access for non-root execution
RUN mkdir -p /app/storage/raw /app/services/ingress/storage/raw && chmod -R 777 /app/storage /app/services/ingress/storage

EXPOSE 8000
CMD ["python", "-m", "uvicorn", "main:app", "--host", "0.0.0.0", "--port", "8000"]

# ========================================================
# Stage 3: Heavy ML & OCR Runner (claimgpt-ml image)
# ========================================================
FROM core-runner AS ml-runner

# Install heavy system dependencies for PDF rendering
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    cmake \
    libglib2.0-0 \
    poppler-utils \
    && rm -rf /var/lib/apt/lists/*

# Copy full requirements.txt (which contains PyTorch, PaddleOCR, Transformers)
COPY requirements.txt /app/requirements-ml.txt

# Increase pip timeout and retries for downloading heavy ML/CUDA packages
ENV PIP_DEFAULT_TIMEOUT=1000
ENV PIP_RETRIES=20

# Install CPU-only PyTorch first to prevent CUDA packages from being downloaded
RUN pip install --no-cache-dir torch --index-url https://download.pytorch.org/whl/cpu

# Install the heavy ML libraries. Core requirements are already satisfied
# in the base core-runner image, so pip will skip them and only install ML tools.
RUN pip install --no-cache-dir -r /app/requirements-ml.txt
