# ==============================================================================
# ClaimsGuru Core / API Gateway & Celery Worker Dockerfile (Production)
# Multi-stage build with MS SQL ODBC 18 Driver & WeasyPrint dependencies
# ==============================================================================

# ------------------------------------------------------------------------------
# Stage 1: Build & Python Dependency Wheel Cache
# ------------------------------------------------------------------------------
FROM python:3.11-slim AS builder

WORKDIR /app

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_DEFAULT_TIMEOUT=300 \
    PIP_RETRIES=10

RUN echo 'Acquire::ForceIPv4 "true";' > /etc/apt/apt.conf.d/99force-ipv4 \
    && apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    cmake \
    curl \
    unixodbc-dev \
    g++ \
    && rm -rf /var/lib/apt/lists/*

COPY requirements-gateway.txt /app/requirements.txt
RUN pip install --no-cache-dir --default-timeout=120 --retries=10 -r /app/requirements.txt

# ------------------------------------------------------------------------------
# Stage 2: Final Lightweight Production Runner
# ------------------------------------------------------------------------------
FROM python:3.11-slim AS runner

WORKDIR /app

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PYTHONPATH=/app:/app/libs:/app/services \
    PORT=8000

# Install runtime dependencies: MS SQL Server ODBC Driver 18 + WeasyPrint/Pango/Cairo libs
RUN echo 'Acquire::ForceIPv4 "true";' > /etc/apt/apt.conf.d/99force-ipv4 \
    && apt-get update && apt-get install -y --no-install-recommends \
    curl \
    gnupg2 \
    apt-transport-https \
    ca-certificates \
    libpango-1.0-0 \
    libpangocairo-1.0-0 \
    libglib2.0-0 \
    libharfbuzz0b \
    libpangoft2-1.0-0 \
    poppler-utils \
    && mkdir -p /usr/share/keyrings \
    && curl -sSL https://packages.microsoft.com/keys/microsoft.asc | gpg --dearmor -o /usr/share/keyrings/microsoft-prod.gpg \
    && curl -sSL https://packages.microsoft.com/config/debian/12/prod.list > /etc/apt/sources.list.d/mssql-release.list \
    && apt-get update \
    && ACCEPT_EULA=Y apt-get install -y --no-install-recommends msodbcsql18 unixodbc \
    && rm -rf /var/lib/apt/lists/*

# Copy installed Python packages from builder stage
COPY --from=builder /usr/local /usr/local

# Copy application source code
COPY libs/ /app/libs/
COPY services/ /app/services/
COPY main.py /app/main.py
COPY init_db.py /app/init_db.py

# Create storage and temp directories with non-root permissions
RUN mkdir -p /app/storage/raw /app/services/ingress/storage/raw /app/tmp \
    && chmod -R 777 /app/storage /app/services/ingress/storage /app/tmp

EXPOSE 8000

# Default entrypoint runs API Gateway / Ingress; overridden by container app commands for workers
CMD ["python", "-m", "uvicorn", "main:app", "--host", "0.0.0.0", "--port", "8000"]
