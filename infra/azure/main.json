              },
              "probes": [
                {
                  "type": "Liveness",
                  "tcpSocket": {
                    "port": 6379
                  },
                  "initialDelaySeconds": 10,
                  "periodSeconds": 15,
                  "failureThreshold": 3
                },
                {
                  "type": "Readiness",
                  "tcpSocket": {
                    "port": 6379
                  },
                  "initialDelaySeconds": 5,
                  "periodSeconds": 10,
                  "failureThreshold": 2
