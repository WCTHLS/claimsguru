                "-Q",
                "default,parser_queue",
                "-c",
                "2"
              ],
              "env": [
                {
                  "name": "APP_ENV",
                  "value": "production"
                },
                {
                  "name": "CELERY_WORKER",
                  "value": "true"
                },
                {
                  "name": "DATABASE_URL",
                  "value": "[format('mssql+pyodbc://{0}:{1}@{2}:1433/{3}?driver=ODBC+Driver+18+for+SQL+Server&TrustServerCertificate=yes', parameters('sqlAdminLogin'), parameters('sqlAdminPassword'), reference(resourceId('Microsoft.Sql/servers', variables('sqlServerName')), '2022-05-01-preview').fullyQualifiedDomainName, variables('sqlDbName'))]"
                },
                {
                  "name": "REDIS_URL",
                  "value": "[variables('redisConnectionString')]"
                },
                {
                  "name": "AZURE_SERVICEBUS_CONNECTION_STRING",
                  "value": "[listKeys(format('{0}/AuthorizationRules/RootManageSharedAccessKey', resourceId('Microsoft.ServiceBus/namespaces', variables('serviceBusName'))), '2022-10-01-preview').primaryConnectionString]"
                },
                {
                  "name": "CELERY_USE_AZURE_SERVICEBUS",
                  "value": "true"
                },
                {
                  "name": "AZURE_STORAGE_CONNECTION_STRING",
                  "value": "[format('DefaultEndpointsProtocol=https;AccountName={0};AccountKey={1};EndpointSuffix={2}', variables('storageAccountName'), listKeys(resourceId('Microsoft.Storage/storageAccounts', variables('storageAccountName')), '2023-01-01').keys[0].value, environment().suffixes.storage)]"
                },
                {
                  "name": "AZURE_STORAGE_ACCOUNT_URL",
                  "value": "[reference(resourceId('Microsoft.Storage/storageAccounts', variables('storageAccountName')), '2023-01-01').primaryEndpoints.blob]"
                },
                {
                  "name": "AZURE_DOCUMENT_INTELLIGENCE_ENDPOINT",
                  "value": "[reference(resourceId('Microsoft.CognitiveServices/accounts', variables('docIntelName')), '2023-05-01').endpoint]"
                },
                {
                  "name": "AZURE_DOCUMENT_INTELLIGENCE_KEY",
                  "value": "[listKeys(resourceId('Microsoft.CognitiveServices/accounts', variables('docIntelName')), '2023-05-01').key1]"
                },
                {
                  "name": "CELERY_BROKER_URL",
                  "value": "[variables('redisConnectionString')]"
                },
                {
                  "name": "CELERY_RESULT_BACKEND",
                  "value": "[variables('redisConnectionString')]"
                },
                {
                  "name": "AZURE_COMMUNICATION_CONNECTION_STRING",
                  "value": "[listKeys(resourceId('Microsoft.Communication/communicationServices', variables('acsName')), '2023-04-01').primaryConnectionString]"
                },
                {
                  "name": "AZURE_COMMUNICATION_SENDER_EMAIL",
                  "value": "[format('DoNotReply@{0}', reference(resourceId('Microsoft.Communication/emailServices/domains', variables('emailServiceName'), 'AzureManagedDomain'), '2023-04-01').fromSenderDomain)]"
                },
                {
                  "name": "ENABLE_EMAIL_NOTIFICATIONS",
                  "value": "true"
                },
                {
                  "name": "ENABLE_NOTIFICATIONS",
                  "value": "true"
                },
                {
                  "name": "AZURE_OPENAI_ENDPOINT",
                  "value": "[parameters('azureOpenAiEndpoint')]"
                },
                {
                  "name": "AZURE_OPENAI_API_KEY",
                  "value": "[parameters('azureOpenAiApiKey')]"
                },
                {
                  "name": "AZURE_OPENAI_DEPLOYMENT",
                  "value": "[parameters('azureOpenAiDeployment')]"
                },
                {
                  "name": "AZURE_OPENAI_API_VERSION",
                  "value": "2024-11-20"
                },
                {
                  "name": "DB_POOL_SIZE",
                  "value": "5"
                },
                {
                  "name": "DB_MAX_OVERFLOW",
                  "value": "5"
                },
                {
                  "name": "CELERY_MAX_TASKS_PER_CHILD",
                  "value": "25"
                }
              ],
              "resources": {
                "cpu": "[json('1.0')]",
                "memory": "2.0Gi"
              }
            }
          ],
          "scale": {
            "minReplicas": 1,
            "maxReplicas": 6
          }
        }
      },
      "dependsOn": [
        "[resourceId('Microsoft.Communication/communicationServices', variables('acsName'))]",
        "[resourceId('Microsoft.App/managedEnvironments', variables('acaEnvName'))]",
        "[resourceId('Microsoft.CognitiveServices/accounts', variables('docIntelName'))]",
        "[resourceId('Microsoft.Communication/emailServices/domains', variables('emailServiceName'), 'AzureManagedDomain')]",
        "[resourceId('Microsoft.ServiceBus/namespaces', variables('serviceBusName'))]",
        "[resourceId('Microsoft.Sql/servers', variables('sqlServerName'))]",
        "[resourceId('Microsoft.Storage/storageAccounts', variables('storageAccountName'))]"
      ]
    },
    {
      "type": "Microsoft.App/containerApps",
      "apiVersion": "2023-05-01",
      "name": "[format('{0}-frontend', variables('prefix'))]",
      "location": "[parameters('location')]",
      "properties": {
        "managedEnvironmentId": "[resourceId('Microsoft.App/managedEnvironments', variables('acaEnvName'))]",
        "configuration": {
          "secrets": [
            {
              "name": "acr-password",
              "value": "[listCredentials(resourceId('Microsoft.ContainerRegistry/registries', variables('acrName')), '2023-07-01').passwords[0].value]"
            }
          ],
          "registries": [
            {
              "server": "[parameters('acrLoginServer')]",
              "username": "[listCredentials(resourceId('Microsoft.ContainerRegistry/registries', variables('acrName')), '2023-07-01').username]",
              "passwordSecretRef": "acr-password"
            }
          ],
          "ingress": {
            "external": true,
            "targetPort": 3000,
            "transport": "auto",
            "customDomains": "[if(not(empty(parameters('frontendCustomDomainName'))), createArray(createObject('name', parameters('frontendCustomDomainName'), 'bindingType', 'SniEnabled', 'certificateId', if(not(empty(parameters('frontendCertificateName'))), format('{0}/managedCertificates/{1}', resourceId('Microsoft.App/managedEnvironments', variables('acaEnvName')), parameters('frontendCertificateName')), null()))), null())]"
          }
        },
        "template": {
          "containers": [
            {
              "name": "claimsguru-frontend",
              "image": "[format('{0}/claimsguru-frontend:{1}', parameters('acrLoginServer'), parameters('imageTag'))]",
              "env": [
                {
                  "name": "NODE_ENV",
                  "value": "production"
                },
                {
                  "name": "NEXT_PUBLIC_APP_NAME",
                  "value": "ClaimsGuru"
                },
                {
                  "name": "NEXT_PUBLIC_API_BASE",
                  "value": "[format('https://{0}', reference(resourceId('Microsoft.App/containerApps', format('{0}-ingress', variables('prefix'))), '2023-05-01').configuration.ingress.fqdn)]"
                },
                {
                  "name": "INGRESS_API",
                  "value": "[format('https://{0}/ingress', reference(resourceId('Microsoft.App/containerApps', format('{0}-ingress', variables('prefix'))), '2023-05-01').configuration.ingress.fqdn)]"
                },
                {
                  "name": "INTERNAL_INGRESS_URL",
                  "value": "[format('http://{0}-ingress:8000/ingress', variables('prefix'))]"
                }
              ],
              "resources": {
                "cpu": "[json('0.5')]",
                "memory": "1.0Gi"
              },
              "probes": [
                {
                  "type": "Liveness",
                  "httpGet": {
                    "path": "/api/health",
                    "port": 3000
                  },
                  "initialDelaySeconds": 15,
                  "periodSeconds": 20,
                  "timeoutSeconds": 3,
                  "failureThreshold": 3
                },
                {
                  "type": "Readiness",
                  "httpGet": {
                    "path": "/api/health",
                    "port": 3000
                  },
                  "initialDelaySeconds": 10,
                  "periodSeconds": 10,
                  "timeoutSeconds": 3,
                  "failureThreshold": 2
                }
              ]
            }
          ],
          "scale": {
            "minReplicas": 1,
            "maxReplicas": 5
          }
        }
      },
      "dependsOn": [
        "[resourceId('Microsoft.App/managedEnvironments', variables('acaEnvName'))]",
        "[resourceId('Microsoft.App/containerApps', format('{0}-ingress', variables('prefix')))]"
      ]
    }
  ],
  "outputs": {
    "ingressFqdn": {
      "type": "string",
      "value": "[reference(resourceId('Microsoft.App/containerApps', format('{0}-ingress', variables('prefix'))), '2023-05-01').configuration.ingress.fqdn]"
    },
    "frontendFqdn": {
      "type": "string",
      "value": "[reference(resourceId('Microsoft.App/containerApps', format('{0}-frontend', variables('prefix'))), '2023-05-01').configuration.ingress.fqdn]"
    },
    "sqlServerFqdn": {
      "type": "string",
      "value": "[reference(resourceId('Microsoft.Sql/servers', variables('sqlServerName')), '2022-05-01-preview').fullyQualifiedDomainName]"
    },
    "redisHost": {
      "type": "string",
      "value": "[format('{0}-redis', variables('prefix'))]"
    },
    "serviceBusName": {
      "type": "string",
      "value": "[variables('serviceBusName')]"
    },
    "storageAccountName": {
      "type": "string",
      "value": "[variables('storageAccountName')]"
    },
    "docIntelEndpoint": {
      "type": "string",
      "value": "[reference(resourceId('Microsoft.CognitiveServices/accounts', variables('docIntelName')), '2023-05-01').endpoint]"
    },
    "communicationServiceEndpoint": {
      "type": "string",
      "value": "[reference(resourceId('Microsoft.Communication/communicationServices', variables('acsName')), '2023-04-01').hostName]"
    },
    "emailSenderDomain": {
      "type": "string",
      "value": "[reference(resourceId('Microsoft.Communication/emailServices/domains', variables('emailServiceName'), 'AzureManagedDomain'), '2023-04-01').fromSenderDomain]"
    }
  }
}