# ==============================================================================
# ClaimsGuru Production Environment Template
# Plug in the final production credentials provided by your manager.
# ==============================================================================

# Core Application Settings
APP_NAME=ClaimsGuru
APP_ENV=production
LOG_LEVEL=INFO

# Azure Microsoft Entra ID (Production Tenant)
ENTRA_TENANT_ID=your-production-tenant-id
ENTRA_CLIENT_ID=your-production-client-id
ENTRA_CLIENT_SECRET=your-production-client-secret
ENTRA_AUTHORITY=https://login.microsoftonline.com/your-production-tenant-id

# Azure SQL Database (Production Server)
DATABASE_URL=mssql+pyodbc://claimsguruadmin:YourStrongPassword123!@claimsguru-prod-sql.database.windows.net:1433/claimsguru?driver=ODBC+Driver+18+for+SQL+Server&TrustServerCertificate=yes
DATABASE_READ_URL=

# Azure Cache for Redis (Production)
REDIS_URL=rediss://:YourRedisPrimaryKey@claimsguru-prod-redis.redis.cache.windows.net:6380/0

# Azure Service Bus (Production Standard Namespace)
AZURE_SERVICE_BUS_CONNECTION_STRING=Endpoint=sb://claimsguru-prod-sb.servicebus.windows.net/;SharedAccessKeyName=RootManageSharedAccessKey;SharedAccessKey=YourServiceBusKey
CELERY_BROKER_URL=azure-servicebus://RootManageSharedAccessKey:YourServiceBusKey@claimsguru-prod-sb.servicebus.windows.net

# Azure Blob Storage / Document Intelligence
AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=https;AccountName=claimsguruprodstorage;AccountKey=YourStorageAccountKey;EndpointSuffix=core.windows.net
AZURE_DOCUMENT_INTELLIGENCE_ENDPOINT=https://claimsguru-docintel.cognitiveservices.azure.com/
AZURE_DOCUMENT_INTELLIGENCE_KEY=YourDocIntelKey

# Frontend Public API URLs
NEXT_PUBLIC_APP_NAME=ClaimsGuru
NEXT_PUBLIC_API_BASE=https://claimsguru-prod-ingress.azurecontainerapps.io
