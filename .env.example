COMPOSE_PROJECT_NAME=claimgpt-feature
 
DATABASE_URL=
 
REDIS_URL=redis://localhost:6380/4
# ---- MinIO (Object Storage)
MINIO_ROOT_USER=claimgpt
MINIO_ROOT_PASSWORD=claimgpt123
 
MINIO_ENDPOINT=http://localhost:9000
CELERY_BROKER_URL=redis://localhost:6380/4
CELERY_RESULT_BACKEND=redis://localhost:6380/4
# ---- Auth (Keycloak)
AUTH_ENABLED=false
NEXT_PUBLIC_KEYCLOAK_URL=http://localhost:9999
AUTH_JWKS_URL=
AUTH_JWT_AUDIENCE=claimgpt
AUTH_JWT_SECRET=dev-secret-change-in-production
 
# ---- Observability
OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
METRICS_ENABLED=false
 
# ---- Chat / LLM
CHAT_LLM_URL=http://llm:8888/v1/chat/completions
CHAT_LLM_MODEL=llama-3-8b
 
WORKFLOW_OCR_URL=http://localhost:8000/ocr
WORKFLOW_PARSER_URL=http://localhost:8000/parser
WORKFLOW_CODING_URL=http://localhost:8000/coding
WORKFLOW_PREDICTOR_URL=http://localhost:8000/predictor
WORKFLOW_FRAUD_URL=http://localhost:8000/fraud
WORKFLOW_VALIDATOR_URL=http://localhost:8000/validator
 
# ---- Submission
FHIR_ENDPOINT=
FHIR_AUTH_TOKEN=
X12_ENDPOINT=
SUBMISSION_DEFAULT_PAYER=generic
 
LOG_LEVEL=INFO
 
# Force Celery pipeline — never fall back to inline single-thread execution
CLAIMGPT_INLINE_PIPELINE=0
 
PARSER_STRUCTURED_EXTRACTION_ENABLED=false
PARSER_LLM_TIMEOUT_SECONDS=20
LOCAL_LLM_GGUF_PATH=
 
# ---- OpenRouter (commented out to run fast local regex + table heuristic parsing)
# OPENROUTER_API_KEY=
# OPENROUTER_CONCURRENT=false
# OPENROUTER_MODEL=google/gemma-4-31b-it:free
# OPENROUTER_URL=
 
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.1-flash-lite
 
# PARSER_SEMANTIC_BACKEND_ORDER=openrouter,qwen2-vl,layoutlmv3,florence-2,donut
PARSER_SEMANTIC_BACKEND_ORDER=
# Threshold (chars) above which diagnosis fields are sent to LLM for cleaning
CODING_DIAGNOSIS_LONG_THRESHOLD=120
# Timeout (seconds) for OpenRouter diagnosis extraction calls
CODING_DIAGNOSIS_LLM_TIMEOUT=30
 
# ---- ICD-10 RAG Embedding Model
# pritamdeka/S-PubMedBert-MS-MARCO: PubMedBERT fine-tuned for medical semantic
# similarity. No hardcoded synonyms needed - the model understands clinical
# abbreviations (FTND, LSCS, SVD) from its PubMed training data.
CODING_EMBEDDING_MODEL=pritamdeka/S-PubMedBert-MS-MARCO
CODING_EMBEDDING_DIM=768
 
CODING_DISABLE_SCISPACY=True
 
# Ignore parser debug artifacts
# parser_debug/
 
OCR_USE_AZURE_OCR=True
AZURE_DOCUMENT_INTELLIGENCE_KEY=
AZURE_DOCUMENT_INTELLIGENCE_ENDPOINT=
AZURE_STORAGE_ACCOUNT_URL=
AZURE_STORAGE_CONNECTION_STRING=
AZURE_SERVICEBUS_CONNECTION_STRING=
 
# AZURE_COMMUNICATION_CONNECTION_STRING=
# AZURE_COMMUNICATION_SENDER_EMAIL="DoNotReply@f036b891-6d1c-40bc-8454-148be3394acc.azurecomm.net"
# AZURE_COMMUNICATION_WHATSAPP_CHANNEL_ID="<your-whatsapp-channel-id>"
 
# ---- Azure OpenAI (Used by Coding Service for ICD-10 & Semantic Extraction)
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=gpt-4o
AZURE_OPENAI_API_VERSION=2024-11-20


# Standard aliases for provisioning & delete-account
ENTRA_PROVISIONING_CLIENT_ID=
ENTRA_PROVISIONING_CLIENT_SECRET=
ENTRA_CLIENT_ID=
ENTRA_CLIENT_SECRET=
ENTRA_SUBDOMAIN=claimsguru
ENTRA_EXTERNAL_ID_ISSUER=